# =========================================================================
# Phase 1 - Data Ingestion - Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =========================================================================

# ---- Application ----
APP_NAME="Predictive Insight Dashboard - Ingestion API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Supabase ----
# Project URL from Supabase dashboard (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (safe for browser; kept here for future auth wiring)
SUPABASE_ANON_KEY=your-anon-key

# Storage bucket name that will hold uploaded datasets
SUPABASE_STORAGE_BUCKET=datasets

# ---- Ingestion limits ----
MAX_UPLOAD_SIZE_MB=200
MAX_ZIP_UNCOMPRESSED_SIZE_MB=1024
MAX_ZIP_FILE_COUNT=200

# ---- Local storage fallback ----
# If Supabase is not configured, files are kept under this local directory
# (useful for tests / local dev). Not meant for production.
LOCAL_STORAGE_DIR=./.local_storage

# The fallback is auto-enabled when APP_ENV != production. In production it is
# refused unless you explicitly opt in here (e.g. running the container with
# ephemeral local storage on purpose). Leave unset in dev.
# LOCAL_FALLBACK_ENABLED=true
